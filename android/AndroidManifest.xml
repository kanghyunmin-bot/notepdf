<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="local.notepdf" android:versionCode="1" android:versionName="1.0.0-rc.1">
 <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35"/>
 <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
 <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
 <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
 <application android:label="NotePDF" android:icon="@drawable/app_icon" android:theme="@style/AppTheme" android:allowBackup="false" android:extractNativeLibs="true" android:supportsRtl="true">
  <activity android:name=".MainActivity" android:exported="true" android:configChanges="orientation|screenSize|keyboardHidden" android:windowSoftInputMode="adjustResize">
   <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
   <intent-filter><action android:name="android.intent.action.SEND"/><category android:name="android.intent.category.DEFAULT"/><data android:mimeType="application/*"/></intent-filter>
   <intent-filter><action android:name="android.intent.action.SEND_MULTIPLE"/><category android:name="android.intent.category.DEFAULT"/><data android:mimeType="application/*"/></intent-filter>
  </activity>
  <service android:name=".ConvertService" android:exported="false" android:foregroundServiceType="dataSync"/>
  <provider android:name=".PdfProvider" android:authorities="local.notepdf.pdf" android:exported="false" android:grantUriPermissions="true"/>
 </application>
</manifest>
